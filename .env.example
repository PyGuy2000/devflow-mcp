# DevFlow MCP — environment configuration example
# Copy to .env and fill in your values (if using a dotenv loader),
# OR set values directly in config.json.
#
# config.json fields:
#
#   projecthub_db_path   Path to your ProjectHub SQLite DB.
#                        Leave empty ("") to disable the bridge.
#                        Example: /home/user/projects/projecthub/data/projecthub.db
#
#   auto_time_entries    true|false — automatically open/close time entries
#                        when tickets move to active/done. Default: true
#
#   default_classification  Label applied to new projects. Default: "personal"

PROJECTHUB_DB_PATH=/path/to/your/projecthub.db
